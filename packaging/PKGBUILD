# Maintainer: Mike Falls <96034740+drowsyclimber@users.noreply.github.com>
#
# Build from this checkout:   cd packaging && makepkg -si
#
# Builds whatever is in the working tree (including uncommitted changes), so it is
# the one to use while hacking on mathwave. PKGBUILD.aur builds a tagged release
# from GitHub, and PKGBUILD-git builds the latest commit on main.
pkgname=mathwave
pkgver=0.4.0
pkgrel=1
pkgdesc="Cava-style terminal audio visualizer that drives a grid of math functions and prints their formulas"
arch=('any')
url="https://github.com/drowsyclimber/mathwave"
license=('MIT')
depends=('python' 'python-numpy')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=(
  'libpulse: parec capture (works with PulseAudio and pipewire-pulse)'
  'pipewire: pw-record capture'
  'alsa-utils: aplay output for --demo --audible'
)
source=()

pkgver() {
  sed -n 's/^version = "\(.*\)"/\1/p' "$startdir/../pyproject.toml"
}

prepare() {
  # Copy the checkout into $srcdir so the build never writes into the repo.
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  cd "$startdir/.."
  cp -r LICENSE README.md pyproject.toml config man src tests "$srcdir/$pkgname/"
  find "$srcdir/$pkgname" -name __pycache__ -prune -exec rm -rf {} +
}

build() {
  cd "$pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"
  PYTHONPATH="$PWD/src" python -m pytest -q
}

package() {
  cd "$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 man/mathwave.1 "$pkgdir/usr/share/man/man1/mathwave.1"
  install -Dm644 config/config "$pkgdir/usr/share/doc/$pkgname/config.example"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
